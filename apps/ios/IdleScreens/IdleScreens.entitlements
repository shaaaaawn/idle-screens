<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Listed explicitly (it is also the default) so the widget extension,
	     which lists the same group, shares the screens' push tokens. First
	     entry: items the app writes land here, where the extension reads. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.hermosalabs.idlescreens</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:idlescreens.com</string>
	</array>
</dict>
</plist>
