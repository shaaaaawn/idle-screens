<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Privacy manifest. Required since 2024-05 for any app whose bundle touches a
	  required-reason API. Re-audited 2026-10-25 against this target's compiled
	  sources (nm shows _NSURLContentModificationDateKey): UserDefaults and file
	  timestamps are the required-reason categories used. System boot time, disk
	  space and active-keyboard APIs have no call sites, so they are deliberately
	  absent rather than forgotten — adding a category the app does not use is
	  its own review problem.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<!--
	  No tracking, so no domains. There is no IDFA, no AppTrackingTransparency and
	  no third-party SDK in either target. The app talks to its own backend; the
	  channel page in its web view also loads Google Fonts, and the 3D tank can
	  fall back to IPFS gateways for fish models. None of those track.
	-->
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!--
	  The app can publish a scene to a channel (MCPClient.publishScene), and the
	  server retains that scene and its history. That is user-authored content
	  leaving the device, so it is declared. It is NOT linked to identity: this
	  product has no accounts and issues capability tokens, not user ids.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<!--
	  CA92.1 — app-owned defaults only. NOT 1C8F.1: that code is for defaults
	  shared through an App Group, and there is no App Group in this project
	  (IdleScreens.entitlements carries associated-domains and nothing else, and
	  the Top Shelf extension reads no defaults at all). Re-check this code if an
	  App Group is ever added.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!--
		  C617.1 — timestamps of files inside the app's own container. The launch
		  stills (Watch/WebScenePool.swift, persistLaunchStills) keep the newest
		  few by modification date in Caches/launch-stills. Nothing leaves the
		  device. Without this, App Store Connect flags ITMS-91053.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
