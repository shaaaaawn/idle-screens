<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Privacy manifest. Required since 2024-05 for any app whose bundle touches a
	  required-reason API. Audited 2026-09-07 against this target's compiled
	  sources: UserDefaults is the only required-reason category used. File
	  timestamps, system boot time, disk space and active-keyboard APIs have no
	  call sites, so they are deliberately absent rather than forgotten — adding a
	  category the app does not use is its own review problem.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<!--
	  No tracking, so no domains. There is no IDFA, no AppTrackingTransparency and
	  no third-party SDK in either target; the only host contacted is the app's own
	  backend.
	-->
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!--
	  This target has no path to MCPClient.publishScene/publishSpec — those live
	  in IdleScreens/App/AppState+VJ.swift, outside the TV target's sources
	  (IdleScreensTV plus IdleScreens/API, Theme, Render, Assets.xcassets). But
	  PerceptionView polls the previewScene MCP tool every 5s with the channel's
	  current scene spec (TVAppState.currentSpecJSON) to render a fallback
	  preview, which is the same user-authored content leaving the device that
	  the iOS manifest declares for publishScene/publishSpec. Declared here for
	  the same reason: under-declaring is the rejection risk.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<!--
	  CA92.1 — app-owned defaults only. NOT 1C8F.1: that code is for defaults
	  shared through an App Group, and there is no App Group in this project
	  (IdleScreens.entitlements carries associated-domains and nothing else, and
	  the Top Shelf extension reads no defaults at all). Re-check this code if an
	  App Group is ever added.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
