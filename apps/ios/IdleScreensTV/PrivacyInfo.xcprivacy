<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Privacy manifest. Required since 2024-05 for any app whose bundle touches a
	  required-reason API. Audited 2026-09-07 across all Swift sources in this
	  project: UserDefaults is the ONLY category used (24 call sites). File
	  timestamps, system boot time, disk space and active-keyboard APIs have zero
	  call sites, so they are deliberately absent rather than forgotten — adding a
	  category the app does not use is its own review problem.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<!--
	  No tracking, so no domains. There is no IDFA, no AppTrackingTransparency and
	  no third-party SDK in either target; the only host contacted is the app's own
	  backend.
	-->
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!--
	  No NSPrivacyCollectedDataTypes: unlike the iOS target, this app has no path
	  to MCPClient.publishScene/publishSpec. The TV target's sources are
	  IdleScreensTV plus IdleScreens/API, Theme, Render and Assets.xcassets — not
	  IdleScreens/App, where AppState+VJ.swift makes the only publish calls. The
	  TV app only previews channels; it never sends user-authored content off
	  the device. Re-check this if TV ever grows a publish/VJ path.
	-->
	<!--
	  CA92.1 — app-owned defaults only. NOT 1C8F.1: that code is for defaults
	  shared through an App Group, and there is no App Group in this project
	  (IdleScreens.entitlements carries associated-domains and nothing else, and
	  the Top Shelf extension reads no defaults at all). Re-check this code if an
	  App Group is ever added.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
