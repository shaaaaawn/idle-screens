# Maintainer: Shawn <shawn@thepartridge.net>
pkgname=idle-screens-wayland
pkgver=0.1.0
pkgrel=1
pkgdesc="Web-engine screensaver overlay for Hyprland/Omarchy (idle-screens)"
arch=(x86_64 aarch64)
url="https://github.com/shaaaaawn/idle-screens"
license=(MIT)
depends=(gtk4 webkitgtk-6.0 gtk4-layer-shell libadwaita)
makedepends=(rust)
optdepends=('hypridle: idle-triggered launch')
source=("$url/releases/download/linux-v$pkgver/idle-screens-wayland-$pkgver-src.tar.gz")
sha256sums=('SKIP') # replace with the checksum printed by make-src-tarball.sh

build() {
  cd "$pkgname-$pkgver"
  # Mark the binary as a release build; build.rs reads this for the About item.
  IDLE_BUILD_KIND=release cargo build --release --locked
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --release --locked
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  # The Omarchy launcher shim: without it the idle wiring has nothing to call,
  # which is why a pacman install used to be less functional than the tarball.
  install -Dm755 packaging/omarchy/omarchy-idle-screens \
    "$pkgdir/usr/bin/omarchy-idle-screens"

  install -d "$pkgdir/usr/share/idle-screens/web"
  cp -r webroot/. "$pkgdir/usr/share/idle-screens/web/"

  # Tray launcher. Autostart is deliberately NOT enabled here -- a package must
  # not write to $HOME. Per user, either run the Omarchy wiring below or:
  #   cp /usr/share/applications/idle-screens-tray.desktop ~/.config/autostart/
  install -Dm644 packaging/omarchy/idle-screens-tray.desktop \
    "$pkgdir/usr/share/applications/idle-screens-tray.desktop"

  # Omarchy wiring, run post-install by the user (they touch ~/.config).
  install -Dm755 packaging/omarchy/install-omarchy.sh \
    packaging/omarchy/install-omarchy-plugin.sh \
    packaging/omarchy/install-hypridle.sh \
    -t "$pkgdir/usr/share/idle-screens/omarchy/"
  install -Dm644 packaging/omarchy/hypridle.listener.snippet \
    -t "$pkgdir/usr/share/idle-screens/omarchy/"

  install -Dm644 packaging/config.toml.example \
    packaging/hypridle.conf.example packaging/hypridle-kiosk.conf.example \
    packaging/hypridle.lua.example \
    -t "$pkgdir/usr/share/doc/$pkgname/"
  [ -f LICENSE ] && install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" || true
}
