# idle-screens-wayland — ~/.config/idle-screens/config.toml
# Every key is optional; CLI flags override the file.

# "savers" = bundled offline engine, "channel" = live idlescreens.com channel
mode = "channel"
# channel id (e.g. "ballet") or a full URL
channel = "ballet"

# Pin one bundled saver by id -- the tray's "Saver" submenu writes this key.
# The catalog is savers.json inside the resolved web bundle (user-local
# ~/.local/share/idle-screens/web, else /usr/share/idle-screens/web).
#saver = "warp"
# Cycle interval in minutes for bundled savers; <= 0 disables
#cycle_minutes = 10
# Dim the saver 0.1..1.0 (night mode)
#brightness = 1.0
# Show the saver-name hint overlay
#hints = true
# Reserved: not yet implemented (currently a no-op, only logs a warning).
# Would hold a Wayland idle inhibitor while showing — WARNING: on Hyprland
# that pauses ALL hypridle listeners (lock, DPMS, suspend).
#inhibit = false
# Fade-in duration in milliseconds (fade-out is half)
#fade_ms = 900
# Fullscreen overlay that ignores mouse/keyboard for exit — the appliance /
# signage shape (a Pi on a wall, a lobby display). Two things dismiss the saver:
# this app's idle watcher AND your idle daemon's resume hook; kiosk needs both
# off. See packaging/hypridle-kiosk.conf.example (Hyprland) or the kiosk block in
# packaging/swayidle/swayidle.snippet (sway/labwc/wayfire/Raspberry Pi OS).
# Exit with: pkill -TERM -f '[i]dle-screens-wayland'
#kiosk = false

# Wayland app-id / window class to report (default "com.idlescreens.wayland").
# Omarchy's Quickshell idle service tracks the screensaver by window class and
# cancels the idle cycle — so the screen never locks — when it sees no window
# of class "org.omarchy.screensaver". omarchy-idle-screens sets this for you.
#app_id = "org.omarchy.screensaver"

[webkit]
# "auto" disables WebKit's DMA-BUF renderer where it is known to misbehave: the
# NVIDIA proprietary driver (flicker/blank) and Broadcom V3D on Raspberry Pi.
# "always" / "never" force it either way.
#
# Raspberry Pi: "auto" turns the renderer OFF. If your Pi actually renders more
# smoothly with it on — worth measuring, since software compositing a fullscreen
# animated WebView is not cheap either — set "never" here. The launch log names
# which branch fired.
disable_dmabuf = "auto"

# Ceiling on what the host page may attempt to render, handed to it as
# ?maxBackend=. "auto" detects Broadcom V3D (Raspberry Pi) and caps it at
# canvas2d, because V3D advertises WebGL2 honestly and still cannot drive
# three.js at fullscreen — support is not capability. "never" trusts the browser;
# a backend name pins it. Raise it if a medium-cost scene runs fine on your box.
#max_backend = "auto"

[update]
# Check for a newer web bundle at launch: "launch" | "never"
check = "launch"
#base_url = "https://idlescreens.com/mac/"
