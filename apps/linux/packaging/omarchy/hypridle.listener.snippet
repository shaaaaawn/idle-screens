# Replace the screensaver listener block in hypridle with this (older,
# hypridle-driven Omarchy). Current Omarchy drives the screensaver from the
# Quickshell idle service instead — see omarchy-launch-screensaver in this
# directory. Or run: ./packaging/omarchy/install-hypridle.sh

# NB the kill pattern: the kernel truncates a process name to 15 chars
# ("idle-screens-wa"), so `pkill -x idle-screens-wayland` never matches and
# the saver is never dismissed. Match the command line; the [i] bracket stops
# the pkill's own shell from matching (and killing) itself.

listener {
    timeout = 150
    on-timeout = pidof hyprlock || omarchy-idle-screens
    on-resume = pkill -TERM -f '[i]dle-screens-wayland'
}

# Kiosk (mouse does not dismiss): use omarchy-idle-screens --kiosk and omit on-resume.
# listener {
#     timeout = 150
#     on-timeout = pgrep -f '[i]dle-screens-wayland' || omarchy-idle-screens --kiosk
# }
