{
  "name": "idle-screens",
  "author": "Shawn Partridge",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "An off-main-thread, capability-tiered, agent-operable screensaver engine for the modern web.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shaaaaawn/idle-screens"
  },
  "homepage": "https://github.com/shaaaaawn/idle-screens#readme",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @idle-screens/playground run test:e2e",
    "test:all": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e",
    "dev": "pnpm --filter @idle-screens/playground run dev",
    "changeset": "changeset"
  },
  "pnpm": {
    "overrides": {
      "tsup>esbuild": ">=0.28.1",
      "brace-expansion@^2": "^2.1.2",
      "brace-expansion@^5": "^5.0.8",
      "fast-uri@<3.1.5": "^3.1.5",
      "js-yaml@^3": "^3.15.1",
      "js-yaml@^4": "^4.3.1",
      "postcss@<8.5.18": "^8.5.18"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@webgpu/types": "^0.1.71",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.2",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
