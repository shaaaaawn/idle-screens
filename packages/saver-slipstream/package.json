{
  "name": "@idle-screens/saver-slipstream",
  "version": "1.0.5",
  "description": "Passthrough wind screensaver for idle-screens: the live page's blocks become obstacles in an analytic potential-flow field \u2014 streamlines thread between the content, part around it, and push it as they pass. Seeded, paramSpace, control-track, frame-addressable.",
  "license": "MIT",
  "author": "Shawn Partridge",
  "repository": {
    "type": "git",
    "url": "https://github.com/shaaaaawn/idle-screens",
    "directory": "packages/saver-slipstream"
  },
  "homepage": "https://github.com/shaaaaawn/idle-screens#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "screensaver",
    "idle",
    "ambient",
    "wind",
    "flow",
    "streamlines",
    "canvas",
    "passthrough"
  ],
  "bugs": {
    "url": "https://github.com/shaaaaawn/idle-screens/issues"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@idle-screens/core": "workspace:^"
  },
  "devDependencies": {
    "@idle-screens/core": "workspace:*"
  }
}
